{
  "name": "trabalho_residencia",
  "version": "1.0.0",
  "description": "Backend para o trabalho de residência",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:api": "npx cypress run --spec \"cypress/api/**/*.spec.js\"",
    "test:acceptance": "npx cypress run --spec \"cypress/e2e/avaliacao-acceptance.spec.js\"",
    "test:load": "node load-tests/relatorio-load.js",
    "test:unit": "npx jest --runInBand",
    "test:setup": "docker compose up -d && sleep 10",
    "test:all": "npm run test:unit && npm run test:api && npm run test:acceptance",
    "comment": "--- Scripts de Migração Simplificados (O Jeito Certo) ---",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "html-pdf-node": "^1.0.8",
    "multer": "^2.0.2",
    "node-pg-migrate": "^7.0.0",
    "nodemailer": "^7.0.11",
    "jsonwebtoken": "^8.5.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "cypress": "^15.16.0",
    "nodemon": "^3.0.1",
    "jest": "^29.0.0",
    "autocannon": "^7.10.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/unit/**/*.spec.js"
    ],
    "testEnvironment": "node"
  }
}
